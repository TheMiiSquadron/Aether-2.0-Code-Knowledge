{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TheMiiSquadron/Aether-2.0-Code-Knowledge/schemas/sources.schema.json",
  "title": "Aether 2.0 Code Knowledge Source Registry",
  "description": "Schema for authoritative upstream documentation sources used by Aether 2.0 Code Knowledge.",
  "type": "object",
  "required": [
    "schemaVersion",
    "sources"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "id",
        "name",
        "provider",
        "authority",
        "topics",
        "sourceType",
        "repository",
        "contentPath",
        "homepage",
        "enabled"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "type": "string",
          "enum": [
            "official",
            "official-reference"
          ]
        },
        "topics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sourceType": {
          "type": "string",
          "enum": [
            "git"
          ]
        },
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "contentPath": {
          "type": "string",
          "minLength": 1
        },
        "homepage": {
          "type": "string",
          "format": "uri"
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}